APP_NAME=GoNetherlandTours
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gonetherlandtours.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# XAMPP defaults
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gonetherlandtours
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# sync locally; use "database" in production with a worker/cron (see docs/reference/DEPLOYMENT.md)
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Local mail: "log" writes to storage/logs/laravel.log. Or use Mailpit (smtp, 127.0.0.1:1025)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="enquiries@gonetherlandtours.test"
MAIL_FROM_NAME="${APP_NAME}"

# Google's published TEST keys (always pass). Replace in production via Admin > Settings or here.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# GoHighLevel (leave blank = integration OFF). Never commit real values.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Preview/staging only: true = noindex everywhere + robots.txt "Disallow: /". Leave false on the live site.
SITE_NOINDEX=false

# First admin account created by `php artisan migrate --seed`
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-please

VITE_APP_NAME="${APP_NAME}"
