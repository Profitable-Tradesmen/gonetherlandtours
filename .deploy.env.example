# Copy to .deploy.env (git-ignored) and fill in. Same values as the GitHub secrets / your SSH login.
LIVE_HOST=
LIVE_PORT=65002
LIVE_USER=
LIVE_PATH=/home/USER/domains/YOURSITE/app   # the folder that contains artisan
LIVE_KEY=~/.ssh/your_key                    # leave empty to use ssh's default key / password prompt

STAGING_HOST=
STAGING_PORT=65002
STAGING_USER=
STAGING_PATH=
STAGING_KEY=
